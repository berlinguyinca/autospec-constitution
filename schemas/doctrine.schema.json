{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec-constitution/schemas/doctrine.schema.json",
  "title": "Autospec Doctrine",
  "description": "Human doctrine document paired with a structured rule file.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "document", "rules"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "document": {"type": "string"},
    "rules": {"type": "string"},
    "purpose": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "quality_gates": {"type": "array", "items": {"$ref": "./quality-gate.schema.json"}},
    "metadata": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
  }
}
