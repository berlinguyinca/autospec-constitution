{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec-constitution/schemas/quality-gate.schema.json",
  "title": "Autospec Quality Gate",
  "description": "Lightweight starter schema for quality gates used by doctrines and profiles.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "purpose",
    "required_evidence",
    "pass_fail_criteria"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pass_fail_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "applies_to_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
