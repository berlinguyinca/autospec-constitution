{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec-constitution/schemas/quality-gate.schema.json",
  "title": "Autospec Quality Gate",
  "description": "A review or validation gate referenced by structured rules.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "summary", "evidence_required"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "evidence_required": {"type": "array", "items": {"type": "string"}},
    "applies_to": {"type": "array", "items": {"type": "string"}},
    "blocking": {"type": "boolean"}
  }
}
