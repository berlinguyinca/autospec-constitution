{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec-constitution/schemas/rule.schema.json",
  "title": "Autospec Rule",
  "description": "Lightweight starter schema for a doctrine rule.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "description",
    "severity",
    "evidence",
    "remediation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "evidence": {
      "type": "array",
      "description": "Evidence expected for evaluating the rule.",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "remediation": {
      "type": "string"
    }
  }
}
