{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berlinguyinca/autospec-constitution/schemas/constitution.schema.json",
  "title": "Autospec Constitution Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "version", "schema", "doctrines"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "schema": {"type": "integer"},
    "doctrines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "document", "rules"],
        "properties": {
          "id": {"type": "string"},
          "document": {"type": "string"},
          "rules": {"type": "string"}
        }
      }
    }
  }
}
